{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.0",
  "envId": "{{env.TCB_ENV_ID}}",
  "region": "ap-shanghai",
  "app": {
    "root": ".",
    "serviceName": "life-ledger-deep-review",
    "framework": "static",
    "installCommand": "npm ci",
    "buildCommand": "npm run build:cloudbase",
    "outputDir": "dist/cloudbase",
    "deployPath": "/",
    "ignore": [
      ".wrangler",
      "coverage",
      "docs/images",
      "tests"
    ]
  }
}
