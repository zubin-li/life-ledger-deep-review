{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "Life Ledger",
  "version": "3.1.0",
  "identifier": "app.zubinli.lifeledger",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "default",
        "local-only"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFOEIzNDM5NkVFNkQ2QjQKUldTMDF1WnVPVFNManE4MDExWkJWYnVyRThOOUN2RXpUWnZMM2xQc3JVbGxsTENsTkhGc1AyWVcK",
      "endpoints": [
        "https://github.com/zubin-li/life-ledger-deep-review/releases/download/mac-updates/latest.json"
      ]
    }
  }
}
